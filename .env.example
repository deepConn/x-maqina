# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Google Cloud Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# Application Configuration
APP_NAME=x-maqina
APP_VERSION=1.0.0-alpha
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/xmaqina
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Vector Database (Weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_BATCH_SIZE=100

# Security
SECRET_KEY=your_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Feature Flags
ENABLE_CYBERSECURITY_ENGINE=true
ENABLE_FINANCIAL_ENGINE=true
ENABLE_DIAGNOSTICS_ENGINE=true
ENABLE_MULTI_AGENT_ENGINE=true
ENABLE_AUTONOMOUS_ENGINE=true

# Gemini Streaming
GEMINI_STREAM_TIMEOUT=300
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7
